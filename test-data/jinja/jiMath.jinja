<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Formulas Evaluation</title>
    <style>
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            padding: 2rem 1rem;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        h1 {
            font-size: 1.5rem;
            text-align: center;
            margin-bottom: 1.5rem;
            color: #1e293b;
        }
        p {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1rem;
            font-weight: 600;
            background-color: #f1f5f9;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 6px;
            border-left: 4px solid #3b82f6;
            display: flex;
            justify-content: space-between;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>All Formulas Live Evaluation</h1>

        <!-- Integer Formulas (1 - 40) -->
        <p>5 + 5 * 10 = <span>{{ 5 + 5 * 10 }}</span></p>
        <p>6 / 5 - 5 * 1 = <span>{{ 6 / 5 - 5 * 1 }}</span></p>
        <p>12 % 5 + 4 * 2 = <span>{{ 12 % 5 + 4 * 2 }}</span></p>
        <p>18 * 12 / 9 + 15 = <span>{{ 18 * 12 / 9 + 15 }}</span></p>
        <p>20 - 16 / 4 + 7 % 3 = <span>{{ 20 - 16 / 4 + 7 % 3 }}</span></p>
        <p>15 * 14 % 8 - 3 = <span>{{ 15 * 14 % 8 - 3 }}</span></p>
        <p>16 / 2 * 5 + 13 % 4 = <span>{{ 16 / 2 * 5 + 13 % 4 }}</span></p>
        <p>100 * 2 / 10 % 7 + 1 = <span>{{ 100 * 2 / 10 % 7 + 1 }}</span></p>
        <p>9 + 9 * 9 / 3 - 5 = <span>{{ 9 + 9 * 9 / 3 - 5 }}</span></p>
        <p>25 % 4 * 12 + 8 - 2 = <span>{{ 25 % 4 * 12 + 8 - 2 }}</span></p>
        <p>14 + 2 % 15 / 10 * 4 = <span>{{ 14 + 2 % 15 / 10 * 4 }}</span></p>
        <p>13 + 7 * 12 - 19 % 5 = <span>{{ 13 + 7 * 12 - 19 % 5 }}</span></p>
        <p>45 / 5 * 3 + 12 - 8 = <span>{{ 45 / 5 * 3 + 12 - 8 }}</span></p>
        <p>8 - 17 * 2 + 16 / 4 = <span>{{ 8 - 17 * 2 + 16 / 4 }}</span></p>
        <p>19 % 2 / 7 + 11 * 3 = <span>{{ 19 % 2 / 7 + 11 * 3 }}</span></p>
        <p>2 * 16 - 1 + 14 % 6 = <span>{{ 2 * 16 - 1 + 14 % 6 }}</span></p>
        <p>50 / 2 % 11 * 3 - 4 = <span>{{ 50 / 2 % 11 * 3 - 4 }}</span></p>
        <p>6 * 8 + 12 / 4 - 15 = <span>{{ 6 * 8 + 12 / 4 - 15 }}</span></p>
        <p>88 % 10 * 4 / 2 + 9 = <span>{{ 88 % 10 * 4 / 2 + 9 }}</span></p>
        <p>13 + 9 % 7 / 8 * 12 = <span>{{ 13 + 9 % 7 / 8 * 12 }}</span></p>
        <p>35 / 7 * 5 - 20 + 8 = <span>{{ 35 / 7 * 5 - 20 + 8 }}</span></p>
        <p>12 * 11 % 15 - 7 + 5 = <span>{{ 12 * 11 % 15 - 7 + 5 }}</span></p>
        <p>10 - 8 - 1 + 40 / 5 = <span>{{ 10 - 8 - 1 + 40 / 5 }}</span></p>
        <p>6 + 9 - 7 % 4 * 2 = <span>{{ 6 + 9 - 7 % 4 * 2 }}</span></p>
        <p>16 % 3 * 20 / 4 + 11 = <span>{{ 16 % 3 * 20 / 4 + 11 }}</span></p>
        <p>15 + 5 + 14 % 3 * 6 = <span>{{ 15 + 5 + 14 % 3 * 6 }}</span></p>
        <p>30 / 3 / 2 * 5 - 1 = <span>{{ 30 / 3 / 2 * 5 - 1 }}</span></p>
        <p>7 * 7 - 49 + 12 % 5 = <span>{{ 7 * 7 - 49 + 12 % 5 }}</span></p>
        <p>18 + 4 - 3 * 6 / 2 = <span>{{ 18 + 4 - 3 * 6 / 2 }}</span></p>
        <p>99 % 10 * 8 + 4 / 2 = <span>{{ 99 % 10 * 8 + 4 / 2 }}</span></p>
        <p>20 + 10 % 11 * 3 - 5 = <span>{{ 20 + 10 % 11 * 3 - 5 }}</span></p>
        <p>14 / 4 * 8 - 12 + 6 = <span>{{ 14 / 4 * 8 - 12 + 6 }}</span></p>
        <p>16 * 10 / 14 + 2 - 5 = <span>{{ 16 * 10 / 14 + 2 - 5 }}</span></p>
        <p>5 + 10 * 15 / 3 % 7 = <span>{{ 5 + 10 * 15 / 3 % 7 }}</span></p>
        <p>12 / 4 + 5 * 6 - 2 = <span>{{ 12 / 4 + 5 * 6 - 2 }}</span></p>
        <p>80 % 9 * 8 - 14 / 2 = <span>{{ 80 % 9 * 8 - 14 / 2 }}</span></p>
        <p>3 + 14 % 19 * 2 - 1 = <span>{{ 3 + 14 % 19 * 2 - 1 }}</span></p>
        <p>70 / 7 * 2 - 15 % 4 = <span>{{ 70 / 7 * 2 - 15 % 4 }}</span></p>
        <p>4 * 4 * 4 / 2 + 8 = <span>{{ 4 * 4 * 4 / 2 + 8 }}</span></p>
        <p>100 - 50 * 2 / 4 % 3 = <span>{{ 100 - 50 * 2 / 4 % 3 }}</span></p>

        <!-- Floating Point Formulas (41 - 60) -->
        <p>5.4 + 6.4 * 2 = <span>{{ 5.4 + 6.4 * 2 }}</span></p>
        <p>10.5 / 2.5 - 1.2 = <span>{{ 10.5 / 2.5 - 1.2 }}</span></p>
        <p>7.2 * 3.5 + 4.1 = <span>{{ 7.2 * 3.5 + 4.1 }}</span></p>
        <p>15.6 - 4.2 / 2.0 = <span>{{ 15.6 - 4.2 / 2.0 }}</span></p>
        <p>8.5 % 3.0 + 2.5 = <span>{{ 8.5 % 3.0 + 2.5 }}</span></p>
        <p>12.25 * 4.0 - 9.5 = <span>{{ 12.25 * 4.0 - 9.5 }}</span></p>
        <p>20.8 / 4.0 * 2.5 = <span>{{ 20.8 / 4.0 * 2.5 }}</span></p>
        <p>3.3 * 3.3 + 0.11 = <span>{{ 3.3 * 3.3 + 0.11 }}</span></p>
        <p>14.4 + 5.6 % 2.5 = <span>{{ 14.4 + 5.6 % 2.5 }}</span></p>
        <p>9.9 - 3.3 * 2.0 + 1.1 = <span>{{ 9.9 - 3.3 * 2.0 + 1.1 }}</span></p>
        <p>25.5 / 5.0 + 4.9 = <span>{{ 25.5 / 5.0 + 4.9 }}</span></p>
        <p>6.2 * 2.0 - 3.4 / 2.0 = <span>{{ 6.2 * 2.0 - 3.4 / 2.0 }}</span></p>
        <p>18.9 % 4.2 + 1.1 = <span>{{ 18.9 % 4.2 + 1.1 }}</span></p>
        <p>0.5 * 100.0 - 45.5 = <span>{{ 0.5 * 100.0 - 45.5 }}</span></p>
        <p>1.2 + 3.4 + 5.6 - 0.2 = <span>{{ 1.2 + 3.4 + 5.6 - 0.2 }}</span></p>
        <p>50.0 / 2.5 % 7.0 = <span>{{ 50.0 / 2.5 % 7.0 }}</span></p>
        <p>7.5 * 2.0 / 3.0 + 8.5 = <span>{{ 7.5 * 2.0 / 3.0 + 8.5 }}</span></p>
        <p>11.1 - 2.2 * 5.0 = <span>{{ 11.1 - 2.2 * 5.0 }}</span></p>
        <p>100.0 % 9.0 * 2.5 = <span>{{ 100.0 % 9.0 * 2.5 }}</span></p>
        <p>4.4 / 1.1 * 5.5 + 0.5 = <span>{{ 4.4 / 1.1 * 5.5 + 0.5 }}</span></p>

        <!-- Boolean/Logical Expressions (61 - 80) -->
        <p>5 &gt; 5 and 6 == 4 = <span>{{ 5 > 5 and 6 == 4 }}</span></p>
        <p>10 &gt;= 10 or 3 &lt; 1 = <span>{{ 10 >= 10 or 3 < 1 }}</span></p>
        <p>not (5 == 5) = <span>{{ not (5 == 5) }}</span></p>
        <p>4 != 5 and 2 &lt;= 8 = <span>{{ 4 != 5 and 2 <= 8 }}</span></p>
        <p>15 / 3 == 5 and 8 % 2 == 0 = <span>{{ 15 / 3 == 5 and 8 % 2 == 0 }}</span></p>
        <p>7 &gt; 10 or 4 * 2 == 9 = <span>{{ 7 > 10 or 4 * 2 == 9 }}</span></p>
        <p>not (4 &gt; 10) and 3 == 3 = <span>{{ not (4 > 10) and 3 == 3 }}</span></p>
        <p>12 % 4 == 0 or 5 != 5 = <span>{{ 12 % 4 == 0 or 5 != 5 }}</span></p>
        <p>8.5 &gt; 5.4 and 3.3 &lt; 4.4 = <span>{{ 8.5 > 5.4 and 3.3 < 4.4 }}</span></p>
        <p>6 * 2 != 12 or 5 + 5 == 9 = <span>{{ 6 * 2 != 12 or 5 + 5 == 9 }}</span></p>
        <p>not (10 &lt; 2) and not (5 &gt; 10) = <span>{{ not (10 < 2) and not (5 > 10) }}</span></p>
        <p>4.5 * 2 == 9.0 and 1 == 0 = <span>{{ 4.5 * 2 == 9.0 and 1 == 0 }}</span></p>
        <p>100 % 10 == 0 or 50 &lt; 25 = <span>{{ 100 % 10 == 0 or 50 < 25 }}</span></p>
        <p>not (True and False) = <span>{{ not (True and False) }}</span></p>
        <p>7 &lt;= 7 and 9 &gt;= 12 = <span>{{ 7 <= 7 and 9 >= 12 }}</span></p>
        <p>3 + 4 == 7 or 5 - 2 == 1 = <span>{{ 3 + 4 == 7 or 5 - 2 == 1 }}</span></p>
        <p>14 % 3 == 2 and 4 * 4 == 16 = <span>{{ 14 % 3 == 2 and 4 * 4 == 16 }}</span></p>
        <p>not (8 != 8) or 2 &gt; 10 = <span>{{ not (8 != 8) or 2 > 10 }}</span></p>
        <p>5.5 + 4.5 == 10.0 and 2 &lt; 1 = <span>{{ 5.5 + 4.5 == 10.0 and 2 < 1 }}</span></p>
        <p>20 / 4 != 5 or 0 == 0 = <span>{{ 20 / 4 != 5 or 0 == 0 }}</span></p>
    </div>

</body>
</html>
