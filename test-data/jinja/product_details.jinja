<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Product Details</title>
    <style>
        body { font-family: sans-serif; background: #f3f4f6; padding: 3rem; text-align: center; }
        .box { background: white; max-width: 400px; margin: 0 auto; padding: 2rem; border-radius: 8px; border: 1px solid #e5e7eb; }
    </style>
</head>
<body>
    <div class="box">
        <span style="color: #4f46e5; font-weight: bold;">{{ product.category }}</span>
        <h1>{{ product.title }}</h1>
        <p>{{ product.description }}</p>
        <h2>${{ product.currentPrice }}</h2>
    </div>
</body>
</html>
