<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Formula Processing System</title>
    <style>
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            padding: 2.5rem 1rem;
        }
        .container {
            max-width: 650px;
            margin: 0 auto;
            background: #ffffff;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        h1 {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            color: #1e293b;
            text-align: center;
        }
        p.subtitle {
            font-size: 0.875rem;
            color: #64748b;
            text-align: center;
            margin-bottom: 2rem;
        }
        .formula-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .formula-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.85rem 1.2rem;
            background-color: #f1f5f9;
            border-radius: 6px;
            border-left: 4px solid #3b82f6;
        }
        .equation {
            font-family: 'Courier New', Courier, monospace;
            font-weight: 600;
            color: #334155;
            font-size: 0.95rem;
        }
        .evaluation {
            font-family: 'Courier New', Courier, monospace;
            font-weight: 700;
            color: #2563eb;
            font-size: 1.05rem;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Formula Execution Engine</h1>
        <p class="subtitle">Rendering computed evaluation results for structured string streams.</p>

        <div class="formula-list">
            <!--
              Since the template cannot calculate raw strings like "5 + 5" on its own,
              your backend view engine should pass an object mapping containing the properties
              below (e.g., mathFormulas = [{"expr": "5 + 5 * 10", "val": 55}, ...])
            -->
            {% for formula in mathFormulas %}
                <div class="formula-row">
                    <!-- Displays the raw equation formula string -->
                    <span class="equation">{{ formula.expr }}</span>

                    <!-- Displays the matching answer outcome -->
                    <span class="evaluation">= {{ formula.val }}</span>
                </div>
            {% endfor %}
        </div>
    </div>

</body>
</html>
