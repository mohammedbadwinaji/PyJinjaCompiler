<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Product Catalog</title>
    <style>
        body { font-family: sans-serif; background: #f3f4f6; padding: 2rem; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; max-width: 800px; margin: 0 auto; }
        .card { background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid #e5e7eb; }
        .title { font-size: 1.25rem; font-weight: bold; margin: 0.5rem 0; }
        .price { color: #2563eb; font-weight: bold; }
    </style>
</head>
<body>
    <!-- Renders the exact custom view tracking header variable -->
    <h1 style="text-align: center; margin-bottom: 2rem;">Snapshot: {{ view_title }}</h1>

    <div class="grid">
        {% for product in products %}
        <div class="card">
            <span style="font-size: 0.8rem; color: #6b7280;">{{ product.category }}</span>
            <div class="title">{{ product.title }}</div>
            <p style="font-size: 0.9rem; color: #4b5563;">{{ product.description }}</p>
            <div class="price">${{ product.currentPrice }}</div>
        </div>
        {% endfor %}
    </div>
</body>
</html>
