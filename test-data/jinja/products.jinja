<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Product Catalog</title>
    <style>
        body { font-family: sans-serif; background: #f3f4f6; padding: 2rem; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; max-width: 800px; margin: 0 auto; }
        .card { background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid #e5e7eb; }
        .title { font-size: 1.25rem; font-weight: bold; margin: 0.5rem 0; }
        .price { color: #2563eb; font-weight: bold; }
        .nav { text-align: center; margin-bottom: 2rem; }
        .nav a { margin: 0 1rem; text-decoration: none; color: #2563eb; }
    </style>
</head>
<body>
    <div class="nav">
        <a href="/products">Products</a>
        <a href="/products/new">Add Product</a>
    </div>
    
    <h1 style="text-align: center; margin-bottom: 2rem;">{{ view_title }}</h1>

    <div class="grid">
        {% for product in products %}
        <div class="card">
            <img src="/{{ product.imageUrl }}" alt="{{ product.title }}" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 1rem;">
            <span style="font-size: 0.8rem; color: #6b7280;">{{ product.category }}</span>
            <div class="title">{{ product.title }}</div>
            <p style="font-size: 0.9rem; color: #4b5563;">{{ product.description }}</p>
            <div class="price">${{ product.currentPrice }}</div>
            <div style="margin-top: 1rem;">
                <a href="/products/{{ product.id }}">View Details</a> |
                <a href="/products/{{ product.id }}/edit">Edit</a> |
                <form action="/products/{{ product.id }}/delete" method="POST" style="display: inline;">
                    <button type="submit" style="background: none; border: none; color: #dc2626; cursor: pointer; text-decoration: underline;">Delete</button>
                </form>
            </div>
        </div>
        {% endfor %}
    </div>
</body>
</html>
